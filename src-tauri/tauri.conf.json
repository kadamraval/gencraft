{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gencraft",
  "version": "0.1.0-beta.4",
  "identifier": "com.gencraft.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gencraft",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Gencraft",
    "copyright": "Copyright (c) Gencraft",
    "category": "GraphicsAndDesign",
    "shortDescription": "AI studio for images, video and voice",
    "longDescription": "Gencraft is a desktop studio for making images, video, voice and finished stories with AI, using your own provider keys. Your files stay on your device.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "Gencraft"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "linux": {
      "deb": {
        "section": "graphics"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5ODlBNzAwODkzOTM1RjUKUldUMU5UbUpBS2VKdVhjQWVZcisvQ0VJMlVpU3JBZnVoL1NtNVE2cUpjWklJR0JLR2xqUzdiVlcK",
      "endpoints": [
        "https://kadamraval.github.io/gencraft/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
